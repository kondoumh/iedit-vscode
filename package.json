{
  "name": "iedit-vscode",
  "displayName": "iEdit Prototype",
  "version": "0.1.0",
  "description": "Prototype VS Code extension for iEdit-style idea processing",
  "publisher": "kondoumh",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:iedit.openPrototype",
    "onView:iedit.outlineView"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "iedit.outlineView",
          "name": "iEdit Outline"
        }
      ]
    },
    "commands": [
      {
        "command": "iedit.openPrototype",
        "title": "iEdit: Open Prototype"
      },
      {
        "command": "iedit.outline.moveUp",
        "title": "iEdit Outline: Move Up"
      },
      {
        "command": "iedit.outline.moveDown",
        "title": "iEdit Outline: Move Down"
      },
      {
        "command": "iedit.outline.indent",
        "title": "iEdit Outline: Indent"
      },
      {
        "command": "iedit.outline.outdent",
        "title": "iEdit Outline: Outdent"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "iedit.outline.moveUp",
          "when": "view == iedit.outlineView",
          "group": "inline@1"
        },
        {
          "command": "iedit.outline.moveDown",
          "when": "view == iedit.outlineView",
          "group": "inline@2"
        },
        {
          "command": "iedit.outline.indent",
          "when": "view == iedit.outlineView",
          "group": "navigation@1"
        },
        {
          "command": "iedit.outline.outdent",
          "when": "view == iedit.outlineView",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "watch": "node ./scripts/build.mjs --watch",
    "vscode:prepublish": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "kondoumh",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.11",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "vis-data": "^8.0.3",
    "vis-network": "^10.0.2"
  }
}
